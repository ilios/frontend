{
  "name": "frontend",
  "version": "49.1.0",
  "private": true,
  "description": "Curriculum Management System for the Health Professions",
  "repository": "https://github.com/ilios/frontend",
  "license": "MIT",
  "author": "The Ilios Team (info@iliosproject.org)",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "format": "prettier . --cache --write",
    "lint": "pnpm --parallel run \"/^lint:(css|hbs|js|intl)$/\"",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "pnpm lint:css -- --fix",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "vite",
    "test": "vite build --mode development && ember exam --path dist --parallel=${EMBER_EXAM_CONCURRENCY:-8} --load-balance",
    "lint:intl": "ember-intl-lint",
    "lint:intl:fix": "ember-intl-lint --fix",
    "deploy:production": "ember deploy production --activate",
    "deploy:staging": "ember deploy staging --activate",
    "deploy:test": "ember deploy development",
    "deploy:pr-preview": "ember deploy pr-preview",
    "postinstall": "msw init public --no-save",
    "test:screenshots": "pnpm run test --config-file=testem/screenshots-config.js",
    "test:darkmode-screenshots": "pnpm run test  --config-file=testem/screenshots-darkmode-config.js",
    "prepare": "husky"
  },
